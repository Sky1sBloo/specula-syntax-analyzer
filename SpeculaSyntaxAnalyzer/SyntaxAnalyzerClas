#include <vector>
#include <string>
#include <iostream>
#include "Tokens.hpp" // For TokenType

class SyntaxAnalyzer {
public:
    // 1. Empty Constructor
    SyntaxAnalyzer() : mCurrentIndex(0) {}

    // 2. Constructor accepting an array of Tokens
    SyntaxAnalyzer(const std::vector<Token>& tokens) 
        : mTokens(tokens), mCurrentIndex(0) {}

    /**
     * 3. Build function
     * Acts as the entry point for the recursive descent parser.
     */
    void Build() {
        if (mTokens.empty()) {
            return;
        }

        try {
            // Start parsing the top-level grammar rule
            parseProgram();
            std::cout << "Build successful: No syntax errors found." << std::endl;
        } catch (const std::exception& e) {
            std::cerr << "Build failed: " << e.what() << std::endl;
        }
    }

private:
    std::vector<Token> mTokens;
    size_t mCurrentIndex;

    // --- Parser Core Helpers ---

    const Token& peek() const { return mTokens.at(mCurrentIndex); }

    Token advance() {
        if (mCurrentIndex < mTokens.size()) mCurrentIndex++;
        return mTokens.at(mCurrentIndex - 1);
    }

    // Checks if current token matches type and moves forward
    void consume(TokenType expected, std::string message) {
        if (mCurrentIndex < mTokens.size() && peek().type == expected) {
            advance();
            return;
        }
        
        // Provide detailed error using the Token metadata
        const Token& t = peek();
        throw std::runtime_error(message + " at line " + std::to_string(t.line) + 
                                 ", position " + std::to_string(t.char_start));
    }

    // --- Grammar Rules ---

    void parseProgram() {
        while (mCurrentIndex < mTokens.size()) {
            parseStatement();
        }
    }

    void parseStatement() {
        Token current = peek();
        
        // Example: Handle Variable Declaration (let x = 5;)
        if (current.type == TokenType::K_LET) {
            parseDeclaration();
        } 
        // Example: Handle If Statement
        else if (current.type == TokenType::K_IF) {
            parseIfStatement();
        }
        else {
            advance(); // Skip unknown for now
        }
    }

    void parseDeclaration() {
        consume(TokenType::K_LET, "Expected 'let'");
        consume(TokenType::IDENT, "Expected identifier");
        consume(TokenType::OP_EQUALS, "Expected '='");
        // logic for value...
        consume(TokenType::D_SEMICOLON, "Expected ';'");
    }
    
    void parseIfStatement() {
        consume(TokenType::K_IF, "Expected 'if'");
        consume(TokenType::D_PAR_OP, "Expected '('");
        // logic for condition...
        consume(TokenType::D_PAR_CLO, "Expected ')'");
    }
};